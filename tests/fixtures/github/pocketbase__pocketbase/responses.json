  "GET https://raw.githubusercontent.com/pocketbase/pocketbase/5cec579da984436a258602a46a96302fbd31f77c/.github/workflows/release.yaml": {
    "status": 200,
    "headers": {
      "content-type": "text/plain; charset=utf-8"
    },
    "body": "name: basebuild\n\non:\n  pull_request:\n  push:\n\njobs:\n  goreleaser:\n    runs-on: ubuntu-latest\n    env:\n      flags: \"\"\n    steps:\n      # re-enable auto-snapshot from goreleaser-action@v3\n      # (https://github.com/goreleaser/goreleaser-action-v4-auto-snapshot-example)\n      - if: ${{ !startsWith(github.ref, 'refs/tags/v') }}\n        run: echo \"flags=--snapshot\" >> $GITHUB_ENV\n\n      - name: Checkout\n        uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Set up Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '>=25.2.1'\n\n      - name: Set up Go\n        uses: actions/setup-go@v7\n        with:\n          go-version: '>=1.27.1'\n\n      # This step usually is not needed because the /ui/dist is pregenerated locally\n      # but its here to ensure that each release embeds the latest admin ui artifacts.\n      # If the artificats differs, a \"dirty error\" is thrown - https://goreleaser.com/errors/dirty/\n      - name: Build Admin dashboard UI\n        run: npm --prefix=./ui ci && npm --prefix=./ui run build\n\n      # Temporary disable as the types can have random generated identifiers making it non-deterministic.\n      #\n      # # Similar to the above, the jsvm types are pregenerated locally\n      # # but its here to ensure that it wasn't forgotten to be executed.\n      # - name: Generate jsvm types\n      #   run: go run ./plugins/jsvm/internal/types/types.go\n\n      - name: Run tests\n        run: go test ./...\n\n      - name: Run GoReleaser\n        uses: goreleaser/goreleaser-action@v6\n        with:\n          distribution: goreleaser\n          version: '~> v2'\n          args: release --clean ${{ env.flags }}\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n"
  },
  "GET https://raw.githubusercontent.com/pocketbase/pocketbase/5cec579da984436a258602a46a96302fbd31f77c/ui/package.json": {
    "status": 200,
    "headers": {
      "content-type": "text/plain; charset=utf-8"
    },
    "body": "{\n    \"name\": \"PocketBase Superuser UI\",\n    \"private\": true,\n    \"type\": \"module\",\n    \"scripts\": {\n        \"dev\": \"vite\",\n        \"build\": \"dprint fmt && vite build\"\n    },\n    \"dependencies\": {\n        \"leaflet\": \"^1.9.4\",\n        \"pocketbase\": \"^0.28.1\"\n    },\n    \"devDependencies\": {\n        \"dprint\": \"^0.52.0\",\n        \"vite\": \"^8.0.0\"\n    }\n}\n"
  }
