  "GET https://raw.githubusercontent.com/Grandbusta/spyde/8ea92b3bf187ef50513847cc88f29c8b80338d91/package.json": {
    "status": 200,
    "headers": {
      "content-type": "text/plain; charset=utf-8"
    },
    "body": "{\n  \"name\": \"@grandbusta/spyde\",\n  \"version\": \"0.2.1\",\n  \"description\": \"Declarative, composable PDF layout for Node on top of PDFKit. No browser.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"default\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"LICENSE\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/Grandbusta/spyde.git\"\n  },\n  \"homepage\": \"https://github.com/Grandbusta/spyde#readme\",\n  \"bugs\": {\n    \"url\": \"https://github.com/Grandbusta/spyde/issues\"\n  },\n  \"keywords\": [\n    \"pdf\",\n    \"pdfkit\",\n    \"layout\",\n    \"declarative\",\n    \"invoice\",\n    \"report\",\n    \"node\",\n    \"typescript\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit\",\n    \"test\": \"tsc -p tsconfig.test.json && node --test .test-out/test/\",\n    \"clean\": \"rm -rf dist .test-out\",\n    \"example\": \"tsc -p tsconfig.test.json && node .test-out/examples/invoice.js && node .test-out/examples/statement.js\",\n    \"prepublishOnly\": \"npm run clean && npm run build && npm test\",\n    \"preview\": \"tsc -p tsconfig.test.json && node .test-out/examples/preview/server.js\",\n    \"docs:dev\": \"npm --prefix docs run dev\",\n    \"docs:build\": \"npm --prefix docs run build\",\n    \"docs:preview\": \"npm --prefix docs run preview\"\n  },\n  \"dependencies\": {\n    \"pdfkit\": \"^0.20.2\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^20.19.43\",\n    \"@types/pdfkit\": \"^0.17.6\",\n    \"typescript\": \"^7.0.2\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  }\n}\n"
  },
  "GET https://raw.githubusercontent.com/Grandbusta/spyde/8ea92b3bf187ef50513847cc88f29c8b80338d91/.github/workflows/docs.yml": {
    "status": 200,
    "headers": {
      "content-type": "text/plain; charset=utf-8"
    },
    "body": "name: Deploy docs\n\non:\n  push:\n    branches: [main]\n    paths: [\"docs/**\", \".github/workflows/docs.yml\"]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\nconcurrency:\n  group: pages\n  cancel-in-progress: false\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0   # lastUpdated reads git history\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 20\n          cache: npm\n          cache-dependency-path: docs/package-lock.json\n      - uses: actions/configure-pages@v5\n      - run: npm ci\n        working-directory: docs\n      - run: npm run build\n        working-directory: docs\n      - uses: actions/upload-pages-artifact@v3\n        with:\n          path: docs/.vitepress/dist\n\n  deploy:\n    needs: build\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - id: deployment\n        uses: actions/deploy-pages@v4\n"
  },
  "GET https://raw.githubusercontent.com/Grandbusta/spyde/8ea92b3bf187ef50513847cc88f29c8b80338d91/docs/package.json": {
    "status": 200,
    "headers": {
      "content-type": "text/plain; charset=utf-8"
    },
    "body": "{\n  \"name\": \"spyde-docs\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vitepress dev\",\n    \"build\": \"node scripts/llms.mjs && vitepress build\",\n    \"preview\": \"vitepress preview\",\n    \"llms\": \"node scripts/llms.mjs\"\n  },\n  \"devDependencies\": {\n    \"vitepress\": \"^1.6.3\"\n  }\n}\n"
  }
}
