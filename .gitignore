# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local
.claude/settings.local.json
docs/spike/*.mp4

# scripts/render-cards.ts output, for looking at rather than for keeping
/cards

# Rendered into public/ by scripts/render-intro.ts during the build, from the
# committed doc in lib/home-data.json. Bytes in the repo would go stale the moment a
# token moved. ADR-0035.
/public/intro-*.png
